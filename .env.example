# ── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Powers the AI narration in the /agent workspace. Leave EMPTY to run the
# deterministic EDA engine only (parsing, statistics, figures, and fallback
# reports all work without a key).
#
# Get a key at https://openrouter.ai/keys — free models work with a free key.
OPENROUTER_API_KEY=

# ── Storage (optional) ──────────────────────────────────────────────────────
# Workspace threads and website data persist through storage adapters:
#
#  - No DATABASE_URL  → JSON files in .data/ (default; survives restarts)
#  - DATABASE_URL set → MongoDB Atlas (production / serverless)
DATABASE_URL=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical base URL for SEO/OG (set to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (integration boundary) ────────────────────────────────────────
# Checkout runs in clearly-labeled demo mode unless a payment provider is
# configured. To enable live Stripe Checkout, set:
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
