# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
# REQUIRED in production.
AUTH_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# Accounts, sessions, billing records and contact submissions are persisted
# through a storage adapter.
#
#  - No DATABASE_URL  → in-memory adapter (dev / demo; data resets on restart)
#  - DATABASE_URL set → PostgreSQL adapter (production; any Postgres 14+,
#    e.g. Neon, Supabase, Vercel Postgres)
#
# The schema is created automatically on first use.
DATABASE_URL=

# ── Workspace ───────────────────────────────────────────────────────────────
# URL of the existing FINTRA workspace product. Authenticated users visiting
# /workspace (or clicking "Open workspace") are handed off here.
NEXT_PUBLIC_WORKSPACE_URL=https://final-product-one.vercel.app

# ── Payments (integration boundary) ────────────────────────────────────────
# Checkout runs in clearly-labeled demo mode unless a payment provider is
# configured. To enable live Stripe Checkout, set:
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# and implement src/lib/payments/stripe.ts (documented stub included).

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
